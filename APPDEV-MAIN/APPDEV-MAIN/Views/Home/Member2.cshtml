@model APPDEV_MAIN.Models.Member2Information;

@{
    ViewData["Title"] = "Member 2";
}


@section Styles {
    <link rel="stylesheet" href="~/css/Member2Design.css" />
}

<div class="background-image-container">

</div>

<div class="information-container">
    <div class="profile-picture">
        <img src="~/Images/Profile.png" alt="A picture of me"/>
    </div>

    <div class="information">
        <h3>Id: </h3>
        <p>@Model.Id</p>
        <h3>Name: </h3>
        <p>@Model.FullName</p>
        <h3>Address: </h3>
        <p>@Model.Address</p>
    </div>
</div>
