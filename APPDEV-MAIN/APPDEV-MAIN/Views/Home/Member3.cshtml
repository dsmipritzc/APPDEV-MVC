@model APPDEV_MAIN.Models.Member3Information
@{
    ViewData["Title"] = "My Portfolio";
}

<link rel="stylesheet" href="~/css/member3.css" />

<div class="member3">
    <nav>
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#hobbies">Hobbies</a>
        <a href="#contact">Contact</a>
    </nav>

    <div class="profile" id="home">
        <h1>My Portfolio</h1>
        <h2>@Model.FullName</h2>
        <p>@Model.Course</p>

        <hr>

        <h3 id="about">About Me</h3>
        <p>@Model.About</p>

        <h3 id="hobbies">My Hobbies</h3>
        <p>@Model.Hobbies</p>

        <h3 id="contact">Contact</h3>
        <p>Email: @Model.Email</p>
    </div>
</div>
